# KlipperConnect - copy to ~/printer_data/config/klipper_connect.conf

[printer]
# The serial number on the sticker on the back of the printer (CZPX...).
# Connect identifies the printer by it.
serial_number: CZPX0000X000XC00000
# MK3S, MK3, MK25 or MK25S
type: MK3S
# Klipper object names for the fans (used for RPM / power telemetry)
part_fan: fan
hotend_fan: heater_fan nozzle_cooling_fan
# Firmware version shown in Connect. Empty = Klipper's version (0.12.0-123).
#firmware_version:
# Material Connect shows as loaded. Taken from Spoolman's active spool when
# Spoolman is set up in moonraker.conf; this is the fallback.
#default_material: PLA

[connect]
hostname: connect.prusa3d.com
tls: True
# Connect reads this as the PrusaLink version and warns when it's older than
# PrusaLink's latest release. Bump it if Connect says it's deprecated.
#link_version: 0.8.1
# Written by `klipper-connect register`. Kept out of the config folder so the
# token doesn't end up in config backups.
#credentials_file: ~/printer_data/klipper_connect/prusa_connect.ini
#state_file: ~/printer_data/klipper_connect/state.json

[moonraker]
url: http://127.0.0.1:7125
# Only needed if this host isn't a trusted client in moonraker.conf
#api_key:

[storage]
# Files show up in Connect under /<name>/...
name: local
gcodes_path: ~/printer_data/gcodes

[macros]
load_filament: LOAD_FILAMENT
unload_filament: UNLOAD_FILAMENT
# Parameter the macros take for the nozzle temperature (empty = none)
filament_temp_param: TEMP
# Connect's "Start MBL" sends a plain G28 (Prusa firmware levels the bed
# after it). That G28 is followed by this G-code. Empty = plain G28 only.
mbl_gcode: G80

[camera]
# Uncomment snapshot_url to send webcam snapshots to Connect.
# crowsnest/ustreamer serves one on its port (8080 for [cam 1]):
#snapshot_url: http://127.0.0.1:8080/?action=snapshot
name: Webcam
# When to send a snapshot: 10, 30 or 60 (seconds), layer, 5layers or manual.
# Layer triggers need the slicer to emit SET_PRINT_STATS_INFO CURRENT_LAYER=..
trigger: 30
#token_file: ~/printer_data/klipper_connect/camera.json

[bridge]
# Send details/thumbnails of the N newest files up front (0 = on demand only)
file_info_count: 20
telemetry_interval: 1.0
log_level: INFO
