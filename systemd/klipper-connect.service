[Unit]
Description=KlipperConnect - Prusa Connect bridge for Klipper
After=network-online.target moonraker.service
Wants=network-online.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%HOME%
ExecStart=%ENV%/bin/klipper-connect -c %CONFIG% run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
